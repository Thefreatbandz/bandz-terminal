# Copy this file to ".env" and fill in your keys. Never commit .env.

# Required: market data (https://finnhub.io -- free tier works)
FINNHUB_API_KEY=your_key_here

# Optional: AI explanations (https://aistudio.google.com)
# Without it, the dashboard still works -- the Explain buttons just say so.
GEMINI_API_KEY=your_key_here

# Optional: override the Gemini model
# GEMINI_MODEL=gemini-3.6-flash

# Only needed if you revive the Discord bot
# DISCORD_TOKEN=your_token_here
